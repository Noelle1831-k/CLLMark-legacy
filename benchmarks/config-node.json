    "lodash": {"test": ["node", "test/test.js"]},
    "ejs": {"test": ["node_modules/.bin/mocha", "--ui", "tdd", "--reporter", "dot"]},
    "bn.js": {"test": ["node_modules/.bin/mocha", "--reporter", "dot", "test/*-test.js"]}
